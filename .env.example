# GEMINI_API_KEY: Optional AI Studio runtime variable (not used for PII/field data).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# FieldSense AI Runtime & Backend Configuration
PORT=3000
FIELDSENSE_ENV="development"
FIELDSENSE_DATA_DIR="./data"
FIELDSENSE_MAX_UPLOAD_MB=25

# Optional Python FastAPI ML Serving URL (when running Docker / GPU / full Python ML stack)
FIELDSENSE_FASTAPI_URL=""

# Database URL for FastAPI / SQLAlchemy (Docker Compose / PostgreSQL or local SQLite)
DATABASE_URL="sqlite:///./data/fieldsense.db"

# Experiment Tracking
MLFLOW_TRACKING_URI="./experiments/mlruns"
TENSORBOARD_LOG_DIR="./experiments/tensorboard"
